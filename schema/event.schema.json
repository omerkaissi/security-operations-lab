{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse-lab.example/schema/event-1.0.json",
  "title": "Synthetic fitness application event v1.0",
  "description": "Offline schema artifact. Its example URL is an identifier, not a live endpoint. Runtime validation is implemented for Checkpoint 02.",
  "type": "object",
  "required": ["schema_version", "event_id", "timestamp", "actor_id", "event_type", "outcome", "source"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"$ref": "#/$defs/identifier"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "A semantic parser must also reject impossible dates/times and offsets. Timezone required; leap seconds are unsupported."
    },
    "actor_id": {"$ref": "#/$defs/identifier"},
    "event_type": {"enum": ["sign_in", "role_change", "data_export"]},
    "outcome": {"enum": ["success", "failure"]},
    "source": {"enum": ["identity_audit", "application_audit"]},
    "session_id": {"$ref": "#/$defs/identifier"},
    "source_ip": {
      "type": "string",
      "anyOf": [{"format": "ipv4"}, {"format": "ipv6"}],
      "description": "Use ipaddress.ip_address for runtime validation; format annotations may be unenforced."
    }
  },
  "oneOf": [
    {
      "properties": {
        "event_type": {"const": "sign_in"},
        "source": {"const": "identity_audit"}
      }
    },
    {
      "required": ["target_user_id", "previous_role", "new_role"],
      "properties": {
        "event_type": {"const": "role_change"},
        "source": {"const": "identity_audit"},
        "target_user_id": {"$ref": "#/$defs/identifier"},
        "previous_role": {"$ref": "#/$defs/role"},
        "new_role": {"$ref": "#/$defs/role"},
        "change_id": {"$ref": "#/$defs/identifier"}
      }
    },
    {
      "required": ["resource", "record_count"],
      "properties": {
        "event_type": {"const": "data_export"},
        "source": {"const": "application_audit"},
        "resource": {"enum": ["fitness_session_metadata", "public_activity_catalog"]},
        "record_count": {"type": "integer", "minimum": 0}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9_-]+$"},
    "role": {"enum": ["none", "member", "support", "data_export_admin", "organization_admin"]}
  }
}
